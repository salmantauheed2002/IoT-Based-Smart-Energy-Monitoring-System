# Copy this file to .env and fill in your values
# Leave empty or set MOCK_MODE=true to run fully offline

MOCK_MODE=true

# Firebase Realtime Database (only needed when MOCK_MODE=false)
FIREBASE_API_KEY=your_api_key_here
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
FIREBASE_USER_EMAIL=your_email@example.com
FIREBASE_USER_PASSWORD=your_password

# Optional: change the root path used in the database
FIREBASE_DATABASE_PATH=/dev1gf